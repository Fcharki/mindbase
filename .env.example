# Root env file — used ONLY by docker-compose (shared infra values)

POSTGRES_DB=knowledge_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_PORT=5434

# ---------------------------------------------------------------------------
# AI service
# ---------------------------------------------------------------------------
# Every value below is optional: docker-compose supplies the same defaults, so
# uncommenting one only overrides it.

# t5 (fast, extractive) or qwen (abstractive, minutes on CPU).
# AI_SUMMARY_BACKEND=t5

# A caller may name a backend per request to regenerate one entry. qwen is
# refused up front unless AI_ALLOW_SLOW_BACKENDS is on, because its estimated
# cost exceeds the background budget below.
# AI_ALLOW_SLOW_BACKENDS=false

# The slow backend's budget, and the fast one's. Ordering must hold:
#   DB_QUEUE_RETRY_AFTER > job $timeout (900) > background > timeout
# AI_SERVICE_TIMEOUT=120
# AI_SERVICE_BACKGROUND_TIMEOUT=600
# DB_QUEUE_RETRY_AFTER=960

# Width of the embedding vectors, and so of the entry_chunks vector column.
# Changing it invalidates every stored chunk vector.
# AI_EMBEDDING_DIMENSION=1024