APP_NAME=KnowledgeManager
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
FRONTEND_URL=http://localhost:3001
AI_SERVICE_URL=http://localhost:8002
# Must exceed the slowest job's own $timeout (GenerateAssistantAnswer) and
# queue:work --timeout.
DB_QUEUE_RETRY_AFTER=3000
SANCTUM_STATEFUL_DOMAINS=localhost:3001,127.0.0.1:3001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=knowledge_manager
DB_USERNAME=postgres
DB_PASSWORD=secret

# Google config
# GOOGLE_REDIRECT_URI must be listed verbatim under "Authorized redirect URIs"
# on the OAuth 2.0 Web application client, or Google returns
# "Erreur 400 : redirect_uri_mismatch". localhost and 127.0.0.1 are not
# interchangeable, and a trailing slash counts as a different URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/auth/google/callback

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Budgets for the FastAPI service. These must satisfy:
#   DB_QUEUE_RETRY_AFTER (3000) > GenerateAssistantAnswer::$timeout (2700)
#     > AI_SERVICE_ANSWER_TIMEOUT (2400) > AI_SERVICE_BACKGROUND_TIMEOUT (600)
#     > AI_SERVICE_TIMEOUT (120)
# Dropping DB_QUEUE_RETRY_AFTER below a job's $timeout lets a worker re-reserve a
# job that is still running.
#
# Synchronous Guzzle budget. The first call after a container start also pays the
# lazy model load, so this is more than generation time.
AI_SERVICE_TIMEOUT=120
# Queued summary / chunk indexing, allowed to wait for the model to load. Must
# exceed AI_SERVICE_TIMEOUT.
AI_SERVICE_BACKGROUND_TIMEOUT=600
# One queued assistant answer. Kept separate from the background timeout above,
# which would also change what a summary may pick. Must stay below
# GenerateAssistantAnswer::$timeout.
AI_SERVICE_ANSWER_TIMEOUT=2400
# Off by default, which is what turns an over-budget backend into an up-front 422
# rather than a job that dies at its own timeout. See Services\AI\BackendBudget.
AI_ALLOW_SLOW_BACKENDS=false
# Width of the vectors the AI service returns, and so of the vector column.
# Changing it invalidates every stored chunk vector.
AI_EMBEDDING_DIMENSION=1024
# How long a search question's vector is cached, in seconds. Embeddings are
# deterministic for a given model, so this bounds cache growth, not freshness.
AI_EMBEDDING_CACHE_TTL=2592000
# Extra attempts for a synchronous AI call that failed at the transport level
# (refused connection, 5xx, 429). Worst case is (retries + 1) x AI_SERVICE_TIMEOUT.
AI_SERVICE_RETRIES=2
# Reorder retrieval results with a cross-encoder before cutting to the final
# count. Off falls back to the fused (RRF) order; a runtime failure does too.
AI_RERANK_ENABLED=true
# Passage size and overlap, in characters, for the chunks embedded per entry.
AI_CHUNK_TARGET_CHARS=1800
AI_CHUNK_OVERLAP_CHARS=300

# Cache store. 'database' works out of the box; 'redis' uses the Redis service
# in docker-compose.yml and is faster under load. The app does not require Redis.
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

# php (native extension) is fastest, but predis is a pure-PHP fallback that
# needs no extension. Use "predis" if the php-redis extension is not installed.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"